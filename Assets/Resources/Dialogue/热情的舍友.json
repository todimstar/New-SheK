    "dialogue": [
        {
            "id": "entry",
            "lines": [
                {
                    "speaker": "林逸",
                    "text": "老师，我是来报道的。"
                },
                {
                    "speaker": "报道老师",
                    "text": "欢迎来到大学，同学。你叫什么名字？"
                },
                {
                    "speaker": "林逸",
                    "text": "啊，我叫……林逸。"
                },
                {
                    "speaker": "报道老师",
                    "text": "别紧张，慢慢来。这是你的宿舍钥匙，这是班级群的二维码，你扫码加一下。我就是你们班班主任了，以后有什么通知我都会在里面发。"
                }
            ],
            "options": [
                {
                    "optionText": "继续",
                    "nextNodeId": "dorm"
                }
            ]
        },
        {
            "id": "dorm",
            "lines": [
                {
                    "speaker": "周海",
                    "text": "嘿，你好，我是周海，欢迎你，以后我们就是大学四年的舍友了。"
                },
                {
                    "speaker": "林逸",
                    "text": "啊……你好，林逸。"
                },
                {
                    "speaker": "周海",
                    "text": "你要是累了，先休息一下吧，我出去买东西了。还有个舍友已经回来，但他现在出去玩了。"
                },
                {
                    "speaker": "林逸",
                    "text": "这就是我的舍友吗，好像没这么可怕，还…有点友善"
                }
            ],
            "options": []
        }
    ]
}